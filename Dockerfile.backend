FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY app/backend/pyproject.toml app/backend/README.md ./
RUN pip install --no-cache-dir -e ".[postgres,tables,reranker]"

# Copy application code
COPY app/backend/src/ ./src/
COPY app/backend/alembic/ ./alembic/
COPY app/backend/alembic.ini ./alembic.ini
COPY app/backend/scripts/ ./scripts/
COPY app/backend/data/ ./data/

EXPOSE 8000

CMD ["uvicorn", "hospital_ai.main:app", "--host", "0.0.0.0", "--port", "8000"]
