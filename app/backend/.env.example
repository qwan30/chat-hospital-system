# Hospital AI — Backend Environment Configuration Example
# Copy this file to .env for local development

# Database Configuration
HOSPITAL_AI_DATABASE_URL=postgresql+asyncpg://hospital_ai:hospital_ai@localhost:5432/hospital_ai
HOSPITAL_AI_REDIS_URL=redis://localhost:6379/0

# Storage Configuration
HOSPITAL_AI_STORAGE_ROOT=./storage

# Security & Secrets
HOSPITAL_AI_JWT_SECRET=dev-secret-key-change-in-production-min-32-chars!
HOSPITAL_AI_JWT_ALGORITHM=HS256
HOSPITAL_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082

# AI Models & Providers
HOSPITAL_AI_EMBEDDING_PROVIDER=ollama
HOSPITAL_AI_CHAT_PROVIDER=ollama
HOSPITAL_AI_LLM_BASE_URL=http://localhost:11434

# Environment Mode
HOSPITAL_AI_ENVIRONMENT=development
