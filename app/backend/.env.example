HOSPITAL_AI_ENVIRONMENT=local
HOSPITAL_AI_API_V1_PREFIX=/api/v1
HOSPITAL_AI_DATABASE_URL=postgresql+asyncpg://hospital_ai:hospital_ai@localhost:5432/hospital_ai
HOSPITAL_AI_REDIS_URL=redis://localhost:6379/0
HOSPITAL_AI_STORAGE_ROOT=.local_storage
HOSPITAL_AI_STORAGE_BACKEND=local
HOSPITAL_AI_R2_ENDPOINT=
HOSPITAL_AI_R2_BUCKET=
HOSPITAL_AI_R2_REGION=auto
HOSPITAL_AI_R2_ACCESS_KEY_ID=
HOSPITAL_AI_R2_SECRET_ACCESS_KEY=
HOSPITAL_AI_WORKER_INLINE=false
HOSPITAL_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Backend-issued synthetic demo sessions. Keep the secret backend-only; never expose it to the frontend.
HOSPITAL_AI_DEMO_MODE=true
HOSPITAL_AI_DEMO_JWT_SECRET=
HOSPITAL_AI_DEMO_JWT_ISSUER=hospital-ai-demo
HOSPITAL_AI_DEMO_TOKEN_TTL_MINUTES=30

# Local development bearer tokens, formatted as token:email pairs.
HOSPITAL_AI_DEV_BEARER_TOKENS=dev-doctor:doctor@example.test,dev-nurse:nurse@example.test,dev-pharmacist:pharmacist@example.test,dev-records:records@example.test,dev-security:security@example.test,dev-admin:admin@example.test,dev-frontdesk:frontdesk@example.test

# Deterministic adapters make unit tests and local demos run without external calls.
# Ollama is a local-only option. Do not configure Ollama for the Dokploy/VPS stack.
# For the VPS profile, set chat/embedding providers to "gemini" and inject keys
# through Dokploy secrets. The OpenAI-compatible settings below can target
# DeepSeek when the provider is explicitly set to "openai".
HOSPITAL_AI_EMBEDDING_PROVIDER=deterministic
HOSPITAL_AI_CHAT_PROVIDER=stub
HOSPITAL_AI_OLLAMA_BASE_URL=http://localhost:11434
HOSPITAL_AI_EMBEDDING_MODEL=bge-m3
HOSPITAL_AI_CHAT_MODEL=qwen2.5:7b
HOSPITAL_AI_EMBEDDING_DIMENSIONS=1024
HOSPITAL_AI_RETRIEVAL_TOP_K=5
HOSPITAL_AI_EVIDENCE_THRESHOLD=0.2
HOSPITAL_AI_MAX_UPLOAD_BYTES=10485760

# OpenAI / OpenAI-compatible provider (Groq, Together, Mistral, etc.)
HOSPITAL_AI_OPENAI_API_KEY=
HOSPITAL_AI_OPENAI_BASE_URL=https://api.openai.com/v1
HOSPITAL_AI_OPENAI_CHAT_MODEL=gpt-4o-mini
HOSPITAL_AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dokploy explicit DeepSeek override (do not enable automatic fallback here):
# HOSPITAL_AI_OPENAI_BASE_URL=https://api.deepseek.com/v1
# HOSPITAL_AI_OPENAI_CHAT_MODEL=deepseek-chat

# RAG tuning parameters
HOSPITAL_AI_CHUNK_SIZE=512
HOSPITAL_AI_CHUNK_OVERLAP=64
HOSPITAL_AI_SYSTEM_PROMPT=You are a hospital knowledge assistant. Answer only from the evidence. Cite every factual claim using evidence IDs like [E1].
HOSPITAL_AI_STREAMING_ENABLED=true

# HMS integration (connect to hospital-management-system for clinical data sync)
HOSPITAL_AI_HMS_BASE_URL=http://localhost:8080/api/v1
HOSPITAL_AI_HMS_API_KEY=
HOSPITAL_AI_HMS_SYNC_ENABLED=false
HOSPITAL_AI_HMS_SYNC_TIMEOUT_SECONDS=30

# Reranker configuration (Phase 3)
# Options: keyword | cross_encoder | tei | cohere
HOSPITAL_AI_RERANKER_PROVIDER=keyword
HOSPITAL_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HOSPITAL_AI_RERANKER_TOP_K=5
HOSPITAL_AI_RERANKER_TEI_URL=
HOSPITAL_AI_COHERE_API_KEY=

# Hybrid search (Phase 3)
# Options: vector | bm25 | hybrid
HOSPITAL_AI_RETRIEVAL_MODE=vector
HOSPITAL_AI_BM25_WEIGHT=0.4
HOSPITAL_AI_VECTOR_WEIGHT=0.6

# Graph RAG (Phase 4) — SQL-backed, no extra infra needed
# Entities and relations are extracted automatically during document indexing.
# Drug interaction checks run automatically on chat queries.


# Google Gemini provider
HOSPITAL_AI_GEMINI_API_KEY=
HOSPITAL_AI_GEMINI_CHAT_MODEL=gemini-2.0-flash

# HMS JWT/OIDC production profile (RS256/JWKS; never commit real values).
HOSPITAL_AI_JWT_ISSUER=
HOSPITAL_AI_JWT_AUDIENCE=
HOSPITAL_AI_JWKS_URL=
HOSPITAL_AI_JWT_ALGORITHM=RS256
HOSPITAL_AI_JWT_HMAC_SECRET=

